{
  "manifest_version": 3,
  "name": "Scroll Meter",
  "version": "0.3.0",
  "description": "Measures how far you scroll every day and turns it into ridiculous real-world comparisons.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Scroll Meter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
